    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "node-cron": "^4.5.0",
    "openai": "^6.45.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.9"
  }
